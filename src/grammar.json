{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "brainfuckplus",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_instruction"
      }
    },
    "_instruction": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "increment"
        },
        {
          "type": "SYMBOL",
          "name": "decrement"
        },
        {
          "type": "SYMBOL",
          "name": "move_right"
        },
        {
          "type": "SYMBOL",
          "name": "move_left"
        },
        {
          "type": "SYMBOL",
          "name": "output"
        },
        {
          "type": "SYMBOL",
          "name": "input"
        },
        {
          "type": "SYMBOL",
          "name": "loop"
        },
        {
          "type": "SYMBOL",
          "name": "mov_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "zero_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "add_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "sub_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "cellreference"
        }
      ]
    },
    "increment": {
      "type": "STRING",
      "value": "+"
    },
    "decrement": {
      "type": "STRING",
      "value": "-"
    },
    "move_right": {
      "type": "STRING",
      "value": ">"
    },
    "move_left": {
      "type": "STRING",
      "value": "<"
    },
    "output": {
      "type": "STRING",
      "value": "."
    },
    "input": {
      "type": "STRING",
      "value": ","
    },
    "cellreference": {
      "type": "STRING",
      "value": "#"
    },
    "mov_keyword": {
      "type": "STRING",
      "value": "mov"
    },
    "zero_keyword": {
      "type": "STRING",
      "value": "zero"
    },
    "add_keyword": {
      "type": "STRING",
      "value": "add"
    },
    "sub_keyword": {
      "type": "STRING",
      "value": "sub"
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+"
    },
    "string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "string_escape"
              },
              {
                "type": "PATTERN",
                "value": "[^\"\\\\\\n]+"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "string_escape": {
      "type": "PATTERN",
      "value": "\\\\."
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "::"
          },
          {
            "type": "PATTERN",
            "value": "[^\\(\\n][^\\n]*"
          }
        ]
      }
    },
    "block_comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "::("
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^)]"
                },
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "STRING",
                      "value": ")"
                    },
                    {
                      "type": "PATTERN",
                      "value": "[^:]"
                    }
                  ]
                },
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "STRING",
                      "value": "):"
                    },
                    {
                      "type": "PATTERN",
                      "value": "[^:]"
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": ")::"
          }
        ]
      }
    },
    "loop": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_instruction"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    },
    {
      "type": "SYMBOL",
      "name": "block_comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}