{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "brainfuckplus",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_instruction"
      }
    },
    "_instruction": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "increment"
        },
        {
          "type": "SYMBOL",
          "name": "decrement"
        },
        {
          "type": "SYMBOL",
          "name": "move_right"
        },
        {
          "type": "SYMBOL",
          "name": "move_left"
        },
        {
          "type": "SYMBOL",
          "name": "output"
        },
        {
          "type": "SYMBOL",
          "name": "input"
        },
        {
          "type": "SYMBOL",
          "name": "loop"
        },
        {
          "type": "SYMBOL",
          "name": "mov_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "zero_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        }
      ]
    },
    "increment": {
      "type": "STRING",
      "value": "+"
    },
    "decrement": {
      "type": "STRING",
      "value": "-"
    },
    "move_right": {
      "type": "STRING",
      "value": ">"
    },
    "move_left": {
      "type": "STRING",
      "value": "<"
    },
    "output": {
      "type": "STRING",
      "value": "."
    },
    "input": {
      "type": "STRING",
      "value": ","
    },
    "mov_keyword": {
      "type": "STRING",
      "value": "mov"
    },
    "zero_keyword": {
      "type": "STRING",
      "value": "zero"
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+"
    },
    "loop": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_instruction"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}